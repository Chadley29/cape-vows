---
import Base from '../layouts/Base.astro';
import ResearchPanel from '../components/ResearchPanel.jsx';

const title = 'Admin | Cape Vows';
const description = 'Internal venue research tool.';
---

<Base title={title} description={description} canonical={null}>
  <meta name="robots" content="noindex" slot="head" />

  <section style="padding-top: 3rem;">
    <div class="section-header">
      <div>
        <div class="section-eyebrow">Internal</div>
        <h1 class="section-title">Venue <em>Research</em></h1>
      </div>
    </div>

    <ResearchPanel client:load />
  </section>
</Base>
